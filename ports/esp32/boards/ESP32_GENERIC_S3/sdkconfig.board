CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-8MiB.csv"

# Fluispotter: raise the ESP-IDF Interrupt Watchdog timeout 300 -> 1000 ms.
# The mid-session reboots (machine.reset_cause() == WDT / code 3) were the
# interrupt watchdog firing on a transient >300 ms interrupts-off window in the
# WiFi/lightsleep path. Confirmed on-board: disable_irq()+800 ms busy -> WDT
# reset; TIMG1 IWDT is the only armed watchdog (RTC WDT + TG0 WDT disabled).
# Flash (os.sync ~33 us even with WiFi TX), the lightsleep path (40/40), the
# motor kick and power were all ruled out by measurement. 3x margin absorbs the
# transient; the ULP regulates the pumps independently of CPU interrupts, so a
# longer interrupt watchdog is safe. Keep the watchdog ENABLED.
# See fluispotter/fluispotter-firmware issue #44. Tunable (500-1000 ms).
CONFIG_ESP_INT_WDT_TIMEOUT_MS=1000

# Fluispotter: pin the brownout detector ON explicitly (safety — a medical
# device must reset cleanly on a failing supply rather than run pumps on a sag).
# This is the IDF default (level 7, ~2.51 V, most sensitive), made explicit so
# it can't drift with an IDF default change. A brownout then reports as
# reset cause PWRON/brownout (code 1), distinct from the WDT (code 3) reboots
# above (which are interrupt-timing, not power).
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y
